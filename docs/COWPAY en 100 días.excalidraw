      "type": "text",
      "x": 3397.153502211986,
      "y": -607.0501656255906,
      "width": 378.1646728515625,
      "height": 276.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
