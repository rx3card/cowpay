// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Restaurante {
  id        String  @id @default(uuid())
  nombre    String
  slug      String  @unique
  direccion String
  telefono  String
  fotoUrl   String?
  latitud   Float
  longitud  Float

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  staff     Staff[]
  reseñas   Reseña[]
  categorias   Categoria[]
  ingredientes Ingrediente[]
  mesas        Mesa[]
  horarios     HorarioAtencion[]
}


model Categoria {
  id     String @id @default(uuid())
  nombre String
  orden  Int    @default(0)

  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  restauranteId String
  deletedAt     DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  platos Plato[]
  @@index([restauranteId])
}


model Plato {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Int
  fotos       String[]
  disponible  Boolean @default(true)

  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId String
  deletedAt   DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  recetaItems  RecetaItem[]
  lineasPedido LineaPedido[]
  @@index([categoriaId])
}





model Ingrediente {
  id          String  @id @default(uuid())
  nombre      String
  stockActual Decimal @db.Decimal(10, 2)
  unidad      String
  stockMinimo Decimal @db.Decimal(10, 2) @default(0)

  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  restauranteId String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  recetaItems RecetaItem[]
  @@index([restauranteId])
}


model RecetaItem {
  id                String  @id @default(uuid())
  cantidadNecesaria Decimal @db.Decimal(10, 2)

  plato   Plato  @relation(fields: [platoId], references: [id])
  platoId String

  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id])
  ingredienteId String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([platoId, ingredienteId])
  @@index([platoId])
  @@index([ingredienteId])
}



model Mesa {
  id        String  @id @default(uuid())
  numero    String
  capacidad Int

  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  restauranteId String
  deletedAt     DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  codigoQR CodigoQR?
  sesiones SesionMesa[]
  @@index([restauranteId])
  @@unique([restauranteId, numero])
}


model CodigoQR {
  id     String  @id @default(uuid())
  token  String  @unique
  activo Boolean @default(true)

  mesa   Mesa   @relation(fields: [mesaId], references: [id])
  mesaId String @unique

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}


model SesionMesa {
  id        String    @id @default(uuid())
  abiertaEn DateTime  @default(now())
  cerradaEn DateTime?

  mesa   Mesa   @relation(fields: [mesaId], references: [id])
  mesaId String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  comensales Comensal[]
  cuentas    Cuenta[]
  	@@index([mesaId])
}


model Comensal {
  id             String  @id @default(uuid())
  nombreTemporal String
  color          String?

  sesionMesa   SesionMesa @relation(fields: [sesionMesaId], references: [id])
  sesionMesaId String
  partesCuenta ParteCuenta[]
  lineasPedido LineaPedido[]
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  @@index([sesionMesaId])
  @@index([usuarioId])
}


model Cuenta {
  id        String       @id @default(uuid())
  estado    EstadoCuenta @default(ABIERTA)
  subtotal  Int          @default(0)
  propina   Int          @default(0)
  total     Int          @default(0)
  cerradaEn DateTime?

  sesionMesa   SesionMesa @relation(fields: [sesionMesaId], references: [id])
  sesionMesaId String

  mesero   Staff  @relation(fields: [meseroId], references: [id])
  meseroId String

  partesCuenta ParteCuenta[]
  pedidos      Pedido[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([sesionMesaId])
  @@index([meseroId])
}


model Pedido {
  id       String   @id @default(uuid())
  creadoEn DateTime @default(now())
  estado   EstadoPedido @default(RECIBIDO)

  actualizadoEn DateTime @updatedAt

  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])
  cuentaId String

  lineas LineaPedido[]
  @@index([cuentaId])
}


model LineaPedido {
  id             String @id @default(uuid())
  cantidad       Int
  precioUnitario Int
  notas          String?

  pedido   Pedido @relation(fields: [pedidoId], references: [id])
  pedidoId String

  plato   Plato  @relation(fields: [platoId], references: [id])
  platoId String

  comensal   Comensal? @relation(fields: [comensalId], references: [id])
  comensalId String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  @@index([pedidoId])
  @@index([platoId])
  @@index([comensalId])
}


enum RolStaff {
  ADMINISTRADOR
  MESERO
  COCINERO
  CAJERO
}

model Usuario {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  nombre       String
  telefono     String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  staff     Staff?
  comensales Comensal[]
  reseñas   Reseña[]
}

model Staff {
  id     String   @id @default(uuid())
  rol    RolStaff
  activo Boolean  @default(true)

  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  restauranteId String

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String  @unique

  creadoEn      DateTime @default(now())
  cuentas Cuenta[]
  actualizadoEn DateTime @updatedAt
  @@index([restauranteId])
}

model Reseña {
  id          String  @id @default(uuid())
  calificacion Int
  comentario  String?

  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  restauranteId String

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([restauranteId, usuarioId])
  @@index([restauranteId])
}

model ParteCuenta {
  id       String @id @default(uuid())
  subtotal Int
  total    Int

  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])
  cuentaId String

  comensal   Comensal @relation(fields: [comensalId], references: [id])
  comensalId String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  pagos Pago[]

  @@unique([cuentaId, comensalId])
  @@index([cuentaId])
  @@index([comensalId])
}

model Pago {
  id     String @id @default(uuid())
  monto  Int
  metodo String

  parteCuenta   ParteCuenta @relation(fields: [parteCuentaId], references: [id])
  parteCuentaId String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  transaccion TransaccionPago?
  @@index([parteCuentaId])
}

model TransaccionPago {
  id                 String  @id @default(uuid())
  proveedor          String
  referenciaExterna  String  @unique
  estado             String
  respuestaCruda     String?

  pago   Pago   @relation(fields: [pagoId], references: [id])
  pagoId String @unique

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}


model HorarioAtencion {
  id            String    @id @default(uuid())
  dia           DiaSemana
  horaApertura  String
  horaCierre    String

  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  restauranteId String

  @@unique([restauranteId, dia])
  @@index([restauranteId])
}

enum EstadoPedido {
  RECIBIDO
  EN_PREPARACION
  LISTO
  ENTREGADO
}
enum EstadoCuenta {
  ABIERTA
  CERRADA
  CANCELADA
}
enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}
