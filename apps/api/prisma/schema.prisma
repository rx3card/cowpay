// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Restaurante {
  id        String  @id @default(uuid())
  nombre    String
  slug      String  @unique
  direccion String
  telefono  String
  horario   String
  fotoUrl   String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  categorias   Categoria[]
  ingredientes Ingrediente[]
  mesas        Mesa[]
}


model Categoria {
  id     String @id @default(uuid())
  nombre String
  orden  Int    @default(0)

  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  restauranteId String

  platos Plato[]
}


model Plato {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Decimal @db.Decimal(10, 2)
  fotoUrl     String?
  disponible  Boolean @default(true)

  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId String

  recetaItems  RecetaItem[]
  lineasPedido LineaPedido[]
}





model Ingrediente {
  id          String  @id @default(uuid())
  nombre      String
  stockActual Decimal @db.Decimal(10, 2)
  unidad      String
  stockMinimo Decimal @db.Decimal(10, 2) @default(0)

  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  restauranteId String

  recetaItems RecetaItem[]
}



model RecetaItem {
  id                String  @id @default(uuid())
  cantidadNecesaria Decimal @db.Decimal(10, 2)

  plato   Plato  @relation(fields: [platoId], references: [id])
  platoId String

  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id])
  ingredienteId String

  @@unique([platoId, ingredienteId])
}



model Mesa {
  id        String  @id @default(uuid())
  numero    String
  capacidad Int
  ocupada   Boolean @default(false)

  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  restauranteId String

  codigoQR CodigoQR?
  sesiones SesionMesa[]
}


model CodigoQR {
  id     String  @id @default(uuid())
  token  String  @unique
  activo Boolean @default(true)

  mesa   Mesa   @relation(fields: [mesaId], references: [id])
  mesaId String @unique
}


model SesionMesa {
  id        String    @id @default(uuid())
  abiertaEn DateTime  @default(now())
  cerradaEn DateTime?

  mesa   Mesa   @relation(fields: [mesaId], references: [id])
  mesaId String

  comensales Comensal[]
  cuentas    Cuenta[]
}


model Comensal {
  id             String  @id @default(uuid())
  nombreTemporal String
  color          String?

  sesionMesa   SesionMesa @relation(fields: [sesionMesaId], references: [id])
  sesionMesaId String
}


model Cuenta {
  id     String  @id @default(uuid())
  estado String  @default("abierta")
  total  Decimal @db.Decimal(10, 2) @default(0)

  sesionMesa   SesionMesa @relation(fields: [sesionMesaId], references: [id])
  sesionMesaId String

  pedidos Pedido[]
}


model Pedido {
  id       String   @id @default(uuid())
  creadoEn DateTime @default(now())
  estado   String   @default("pendiente")

  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])
  cuentaId String

  lineas LineaPedido[]
}


model LineaPedido {
  id             String  @id @default(uuid())
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)

  pedido   Pedido @relation(fields: [pedidoId], references: [id])
  pedidoId String

  plato   Plato  @relation(fields: [platoId], references: [id])
  platoId String
}


